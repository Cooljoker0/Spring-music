{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Google auth user ID" },
        "email": { "type": "string", "description": "User email address" },
        "displayName": { "type": "string", "description": "User display name" },
        "avatarUrl": { "type": "string", "description": "User avatar URL" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp via serverTimestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Update timestamp via serverTimestamp" }
      },
      "required": ["userId", "email"]
    },
    "UserPlaylist": {
      "title": "UserPlaylist",
      "description": "User created or Spotify-imported playlist",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Playlist ID" },
        "userId": { "type": "string", "description": "Owner user ID" },
        "title": { "type": "string", "description": "Playlist title" },
        "description": { "type": "string", "description": "Playlist description" },
        "coverUrl": { "type": "string", "description": "Playlist cover image URL" },
        "songCount": { "type": "integer", "description": "Number of songs" },
        "songsJson": { "type": "string", "description": "Serialized JSON list of songs" },
        "isSpotifyImport": { "type": "boolean", "description": "True if imported from Spotify" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last updated timestamp" }
      },
      "required": ["id", "userId", "title"]
    },
    "LikedSong": {
      "title": "LikedSong",
      "description": "User saved/liked track",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Document ID" },
        "userId": { "type": "string", "description": "Owner user ID" },
        "songId": { "type": "string", "description": "Track ID" },
        "title": { "type": "string", "description": "Track title" },
        "artist": { "type": "string", "description": "Artist name" },
        "album": { "type": "string", "description": "Album title" },
        "coverUrl": { "type": "string", "description": "Track artwork URL" },
        "streamUrl": { "type": "string", "description": "Audio stream URL" },
        "durationMs": { "type": "integer", "description": "Track duration in milliseconds" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Liked timestamp" }
      },
      "required": ["id", "userId", "songId", "title", "artist"]
    },
    "UserSettings": {
      "title": "UserSettings",
      "description": "User preferences and AI custom theme styling",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner user ID" },
        "audioQuality": { "type": "string", "description": "Streaming audio quality" },
        "stopOnTaskRemoved": { "type": "boolean", "description": "Stop playback when app is swiped from recents" },
        "customThemePrompt": { "type": "string", "description": "User prompt for AI theme customization" },
        "primaryColorHex": { "type": "string", "description": "Custom primary color hex code" },
        "accentColorHex": { "type": "string", "description": "Custom accent color hex code" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Update timestamp" }
      },
      "required": ["userId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Individual user document containing profile data"
    },
    "/users/{userId}/playlists/{playlistId}": {
      "schema": "UserPlaylist",
      "description": "User playlists subcollection"
    },
    "/users/{userId}/likedSongs/{likedSongId}": {
      "schema": "LikedSong",
      "description": "User liked songs subcollection"
    },
    "/users/{userId}/settings/{settingId}": {
      "schema": "UserSettings",
      "description": "User settings subcollection"
    }
  }
}
